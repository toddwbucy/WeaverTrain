# Copy to .env (gitignored) and fill in. setup-env.sh and the modules read these.

# Archive store: where models are downloaded and kept as permanent references.
WEAVER_TRAIN_MODEL_STORE=/path/to/archive/models
# Fast-load cache: a verified copy of each model, read by loader and trainer.
WEAVER_TRAIN_MODEL_CACHE=/path/to/fast/models
# Local state: verification stamps, env reports, run outputs. Not committed.
WEAVER_TRAIN_STATE_DIR=./var

# Select the training GPUs by PCI bus order, never by CUDA's default heuristic order.
CUDA_DEVICE_ORDER=PCI_BUS_ID
CUDA_VISIBLE_DEVICES=0,1
WEAVER_TRAIN_EXPECT_GPUS=2
WEAVER_TRAIN_EXPECT_GPU_NAME="RTX A6000"

# Hugging Face token (only needed for gated repos; both current models are public).
# HF_TOKEN=

# Unsloth writes generated kernels here (default: the current directory).
UNSLOTH_COMPILE_LOCATION=./var/unsloth_compiled_cache
